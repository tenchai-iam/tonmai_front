   "source": [
    "#### Parallel Func"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 110,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_in_parallel(func, features):\n",
    "    # Create a thread pool with n workers\n",
    "    with concurrent.futures.ThreadPoolExecutor(max_workers=None) as executor:\n",
    "        # Submit tasks to the thread pool and track progress with tqdm\n",
    "        futures = [executor.submit(func, feature) for feature in features]\n",
    "\n",
    "        for future in tqdm(\n",
    "            concurrent.futures.as_completed(futures), total=len(futures)\n",
    "        ):\n",
    "            future.result()"
   ]
  },
