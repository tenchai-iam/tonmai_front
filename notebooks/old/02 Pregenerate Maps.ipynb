    "corridors = io_utils.load_file_from_catalog(\"veg_features\").rename(\n",
    "    columns={\n",
    "        \"nearest upstream device\": \"Nearest Upstream Device\",\n",
    "        \"feeder id\": \"Feeder ID\",\n",
    "        \"count of outages last year\": \"# Outages in Past Year\",\n",
    "        \"count of outages last two years\": \"# Outages in Past 2 Years\",\n",
    "        \"count of outages last three years\": \"# Outages in Past 3 Years\",\n",
    "        # \"vegetation density (%) [MJM]\": \"Vegetation Density (%) [MJM]\",\n",
    "        \"vegetation density (%) [META + Sentinel-2]\": \"Vegetation Density (%) [META + Sentinel-2]\",\n",
    "        \"probability of outage (%)\": \"Probability of Outage (%)\",\n",
    "        \"customers affected (original)\": \"Customers Affected (Original)\",\n",
    "        \"customers affected (adjusted)\": \"Customers Affected (Adjusted)\",\n",
    "        \"cost to trim (BHT) [META + Sentinel-2]\": \"Cost to Trim (BHT) [META + Sentinel-2]\",\n",
    "        \"cost to trim (BHT) [MJM]\": \"Cost to Trim (BHT) [MJM]\",\n",
    "        \"risk (customer interruptions)\": \"Risk (Customer Interruptions)\",\n",
    "        \"risk (customer interruptions) [bins]\": \"Risk (Customer Interruptions, Binned)\",\n",
    "        \"customers affected (adjusted) [bins]\": \"Customers Affected (Adjusted) [Binned]\",\n",
    "        \"probability of outage (%) [bins]\": \"Probability of Outage (%, Binned)\",\n",
    "        \"corridor length\": \"Length (km)\",\n",
    "        \"cost focus scenario frequency\": \"Cost Focus Scenario Frequency\",\n",
    "        \"reliability focus scenario frequency\": \"Reliability Focus Scenario Frequency\",\n",
    "        \"chosen frequency\": \"Chosen Focus Scenario\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "corridors[\"Customers Affected (Original)\"] = (\n",
    "    corridors[\"Customers Affected (Original)\"].map(lambda x: round(x)).map(float)\n",
    ")\n",
    "corridors[\"Customers Affected (Adjusted)\"] = (\n",
    "    corridors[\"Customers Affected (Adjusted)\"].map(lambda x: round(x)).map(float)\n",
    ")\n",
    "corridors[\"Cost to Trim (BHT) [META + Sentinel-2]\"] = corridors[\n",
    "    \"Cost to Trim (BHT) [META + Sentinel-2]\"\n",
    "].map(lambda x: round(x, 2))\n",
    "corridors[\"Cost to Trim (BHT) [MJM]\"] = corridors[\"Cost to Trim (BHT) [MJM]\"].map(\n",
    "    lambda x: round(x, 2)\n",
    ")\n",
    "corridors[\"Risk (Customer Interruptions)\"] = corridors[\n",
    "    \"Risk (Customer Interruptions)\"\n",
    "].map(lambda x: round(x, 2))\n",
    "\n",
    "corridors.head(3)"
