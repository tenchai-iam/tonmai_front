    "    }\n",
    ")\n",
    "\n",
    "veg_clusters[\"Customers Affected (Original)\"] = (\n",
    "    veg_clusters[\"Customers Affected (Original)\"].map(lambda x: round(x)).map(float)\n",
    ")\n",
    "veg_clusters[\"Customers Affected (Adjusted)\"] = (\n",
    "    veg_clusters[\"Customers Affected (Adjusted)\"].map(lambda x: round(x)).map(float)\n",
    ")\n",
    "\n",
    "veg_clusters[\"Cost to Trim (BHT) [META + Sentinel-2]\"] = veg_clusters[\n",
    "    \"Cost to Trim (BHT) [META + Sentinel-2]\"\n",
    "].map(lambda x: round(x, 2))\n",
    "veg_clusters[\"Cost to Trim (BHT) [MJM]\"] = veg_clusters[\"Cost to Trim (BHT) [MJM]\"].map(\n",
    "    lambda x: round(x, 2)\n",
    ")\n",
    "\n",
    "veg_clusters.head(3)"
