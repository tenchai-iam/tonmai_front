def gitBranch = 'develop'
def cmd = ''
def mode = 'develop'
def tag = 'latest'
def gitRevision = ''
def workspace = ''
def cloudName = 'kubernetes' // ตั้งค่าค่าเริ่มต้น  //cluster name config in web jenkins
def kubeCredToUse = ''       // จะใช้ตัวนี้ในการเลือก kubeCred

//stage('build by kaniko')
def image = ''
def preImage = "tcc-harbor.pea.co.th/operation/vegx/front"   //พาทของ images ที่เก็บใน web harbor  //📌 เปลี่ยนตรงนี้ #1
def tagName = 'latest'
def PathDockerfile = ".kaniko/web/TCCDockerfile" //พาทของ dockerfile //📌 เปลี่ยนตรงนี้ #2

//stage('deploy')
def helmNamespace = 'operation'   //กำหนด namespeace  //📌 เปลี่ยนตรงนี้ #3
def helmValue = ''
def appName = 'vegx-front'  //กำหนดชื่อ pod  //📌 เปลี่ยนตรงนี้ #4
def PathChartDev = "values/tcc/values-web-dev.yaml"     //พาทของไฟล์ valuse-dev  //📌 เปลี่ยนตรงนี้ #5
def PathChartStg = "values/tcc/values-web-stg.yaml"  //พาทของไฟล์ valuse-stg  //📌 เปลี่ยนตรงนี ้ #6
def PathChartProd = "values/tcc/values-web.yaml"    //พาทของไฟล์ valuse-prod  //📌 เปลี่ยนตรงนี้ #7

// แยก logic เพื่อกำหนด mode และ cloud ก่อนสร้าง podTemplate
if (env.gitlabBranch != null) {
    gitBranch = "${env.gitlabBranch}";
    echo "🌿 GitLab Branch: ${gitBranch}"
} else {
    gitBranch = "${gitBranch}";
}

// check mode in develop, staging or production
if (gitBranch.indexOf("develop") > -1 || gitBranch.indexOf("feature") > -1) {
    mode = 'develop'
} else if (gitBranch.indexOf("release") > -1 || gitBranch.indexOf("hotfix") > -1) {
    mode = 'staging'
} else if (gitBranch.indexOf("master") > -1 || gitBranch.indexOf("main") > -1) {
    mode = 'production'
}
echo "🚦 Deploy Mode: ${mode}"

cloudName = (mode == 'production') ? 'kubernetes-prod' : 'kubernetes'  //cluster name config in web jenkins
kubeCredToUse = (mode == 'production') ? 'kubeCredProd' : 'kubeCred'
kubeContextName = (mode == 'production') ? 'kubernetes-admin@tcc-data-prod-cluster' : 'tcc-dev'  //Context

// Log configuration
echo "----------------------------------------------------------"
echo "📌 Using Branch: ${gitBranch} (ใช้ Branch: ${gitBranch})"
echo "📌 Mode: ${mode} (โหมด: ${mode})"
echo "📌 Cloud: ${cloudName} (คลาวด์ที่ใช้: ${cloudName})"
echo "📌 Kube Credential: ${kubeCredToUse} (สิทธิ์ Kubernetes ที่ใช้: ${kubeCredToUse})"
echo "📌 Context: ${kubeContextName} (บริบท Kubernetes: ${kubeContextName})"
echo "----------------------------------------------------------"

//podTemplate ของ Jenkins ที่ใช้บน Kubernetes ผ่าน Jenkins Kubernetes Plugin ซึ่งกำหนด template ของ pod ที่จะถูกสร้างขึ้นมาเมื่อ pipeline รันใน environment นั้น
podTemplate(cloud: cloudName, containers: [
    //git 
    //ใช้เพื่อรันคำสั่ง git clone, git fetch, etc.
    containerTemplate(
        args: '9999999', 
        command: 'sleep', 
        image: 'bitnami/git', 
        livenessProbe: containerLivenessProbe(execArgs: '', failureThreshold: 0, initialDelaySeconds: 0, periodSeconds: 0, successThreshold: 0, timeoutSeconds: 0), 
        name: 'git', 
        workingDir: '/home/jenkins/agent'),  //path ที่ Jenkins จะใช้ทำงาน

    //node.js  
    //ใช้สำหรับรัน Node.js เช่น npm install, npm run build  //Build frontend/backend ด้วย Node.js
    containerTemplate(
        args: '9999999', 
        command: 'sleep', 
        image: 'node:18.20-alpine', 
        livenessProbe: containerLivenessProbe(execArgs: '', failureThreshold: 0, initialDelaySeconds: 0, periodSeconds: 0, successThreshold: 0, timeoutSeconds: 0), 
        name: 'node', 
        workingDir: '/home/jenkins/agent'), 

    //kaniko 
    //ใช้สำหรับ build image โดยไม่ต้องใช้ Docker daemon (เหมาะกับ Kubernetes)  //Build image ด้วย Kaniko (Dockerless)
    containerTemplate(
        args: '9999999', 
        command: 'sleep', 
        image: 'gcr.io/kaniko-project/executor:v1.23.2-debug', 
        livenessProbe: containerLivenessProbe(execArgs: '', failureThreshold: 0, initialDelaySeconds: 0, periodSeconds: 0, successThreshold: 0, timeoutSeconds: 0), 
        name: 'kaniko', 
        workingDir: '/home/jenkins/agent'),

    //helm
    //ใช้รันคำสั่ง Helm เช่น helm install, helm upgrade  //Deploy ด้วย Helm
    containerTemplate(
        args: '9999999', 
        command: 'sleep', 
        image: 'fluxcd/helm-operator:1.4.4', 
        livenessProbe: containerLivenessProbe(execArgs: '', failureThreshold: 0, initialDelaySeconds: 0, periodSeconds: 0, successThreshold: 0, timeoutSeconds: 0), 
        name: 'helm', 
        workingDir: '/home/jenkins/agent')
    ], 
    inheritFrom: ' ', 
    namespace: 'cicd',   //กำหนด namespace ที่ Jenkins จะใช้ในการรัน pod ใน Kubernetes
    volumes: [
        secretVolume(mountPath: '/kaniko/.docker', optional: false, secretName: 'kaniko-secret')
    ]) {
    node(POD_LABEL) {

        stage("git clone") {
            container("git") {
                script {
                    try {
                        echo "🔍 Cloning Git Branch: ${gitBranch} (กำลังโคลน Git สาขา: ${gitBranch})"
                        workspace = pwd()
                        git branch: "${gitBranch}", credentialsId: "${gitCred}", url: "${gitUrl}"
                        sh "git config --global --add safe.directory ${workspace}"
                        gitRevision = sh(script: "git log -n 1 --pretty=format:'%H'", returnStdout: true).substring(0, 16)
                        echo "✅ Git Revision: ${gitRevision} (รหัส Commit: ${gitRevision})"
                        
                        if (mode == 'production') {
                            tag = sh(script: 'git tag --points-at HEAD | tail -1', returnStdout: true).trim()
                            echo "🏷️ Production Tag: ${tag} (แท็กโปรดักชัน: ${tag})"
                        }
                    } catch (ex) {
                        echo "⚠️ Git clone failed. Defaulting to develop. (โคลน Git ล้มเหลว เปลี่ยนไปใช้ develop แทน)"
                        gitBranch = "develop";
                        mode = 'develop';
                    }
                }
            }
        }

        stage("pre-build") {
            container("node") {
                ansiColor('xterm') {
                    script {
                        try {
                            echo "📦 Installing dependencies... (กำลังติดตั้ง dependencies...)"
                            sh "npm install --verbose --force"
                            echo "✅ Dependencies installed (ติดตั้ง dependencies เสร็จแล้ว)"
                        } catch (ex) {
                            echo "❌ npm install failed (ติดตั้ง npm ไม่สำเร็จ)"
                            cleanWs()
                            error ex.getMessage()
                        }
                    }
                }
            }
        }

        stage("build") {
            container("node") {
                ansiColor('xterm') {
                    script {
                        echo "🏗️ Starting build for mode: ${mode} (เริ่ม build สำหรับโหมด: ${mode})"
                        if (mode == 'develop') {
                            sh "npm run build:dev"
                        } else if (mode == 'staging') {
                            sh "npm run build:staging"
                        } else if (mode == 'production') {
                            sh "npm run build"
                        } else {
                            sh "npm run build:dev"
                        }
                        echo "✅ Build completed (การ build เสร็จสมบูรณ์)"
                    }
                }
            }
        }

        stage('build by kaniko') {
            container('kaniko') {
                ansiColor('xterm') {
                    script {
                        try {

                            if (mode == 'develop') {
                                image = "${preImage}/dev"
                                tag = tagName
                            } else if (mode == 'staging') {
                                image = "${preImage}/stg"
                                tag = tagName
                            } else if (mode == 'production') {
                                image = "${preImage}/prod"
                            } else {
                                image = "${preImage}/dev"
                                tag = tagName
                            }

                            echo "📤 Building Docker Image: ${image}:${tag} (สร้าง Docker image: ${image}:${tag})"

                            cmd = [
                                "--dockerfile ${workspace}/${PathDockerfile}",
                                "--context ${workspace}",
                                "--destination=${image}:${tag}",
                                "--compressed-caching=false",
                                "--snapshot-mode=redo"
                            ].join(' ')
                            echo "📤 Building Docker Image: ${image}:${tag} (สร้าง Docker image: ${image}:${tag})"
                            echo "🧱 Kaniko Command: /kaniko/executor ${cmd} (คำสั่ง Kaniko: /kaniko/executor ${cmd})"
                            sh "/kaniko/executor ${cmd}"
                            echo "✅ Kaniko build completed (สร้าง image ด้วย Kaniko เสร็จสมบูรณ์)"
                            echo "📸 Docker image: ${image}:${tag} (ชื่อ image ที่จะใช้งาน)"
                        } catch (ex) {
                            echo "❌ Kaniko build failed (การ build ด้วย Kaniko ล้มเหลว)"
                            cleanWs()
                            error ex.getMessage()
                        }
                    }
                }
            }
        }

        stage('deploy') {
            ansiColor('xterm') {
                script {
                    try {
                        echo "🚀 Starting deployment (เริ่มต้นกระบวนการ deploy)"
                        if (mode == 'develop') {
                            helmNamespace = "${helmNamespace}-dev"
                            helmValue = "${PathChartDev}"
                        } else if (mode == 'staging') {
                            helmNamespace = "${helmNamespace}-stg"
                            helmValue = "${PathChartStg}"
                        } else if (mode == 'production') {
                            helmNamespace = "${helmNamespace}"
                            helmValue = "${PathChartProd}"
                        }
                        echo "🔧 Running build command for ${mode} mode (เรียกใช้คำสั่ง build สำหรับโหมด ${mode})"

                    echo "📁 Namespace: ${helmNamespace} (ใช้ namespace: ${helmNamespace})"
                    echo "📄 Helm values file: ${helmValue} (ใช้ไฟล์ Helm: ${helmValue})"

                        //dir และ withCredentials
                        echo "🔐 Writing kubeconfig to config.yaml (สร้างไฟล์ kubeconfig เพื่อใช้เชื่อมต่อ Kubernetes)"
                        dir('.chart') {
                            withCredentials([string(credentialsId: kubeCredToUse, variable: 'KUBECONFIG_BASE64')]) {
                                echo "🔐 Decoding kubeconfig (ถอดรหัส kubeconfig)"
                                sh "echo \$KUBECONFIG_BASE64 | base64 -d -w 0 > config.yaml"
                                echo "🔐 Kubeconfig decoded"
                            }
                        }
                    } catch (ex) {
                        echo "❌ Kubeconfig decode failed: ${ex.getMessage()}"
                        cleanWs()
                        error ex.getMessage()
                    }

                    container('helm') {
                        try {
                            dir('.chart') {
                                echo "📄 Applying Kubernetes secret config (นำ secret เข้า cluster ผ่านไฟล์ namespace-secret-tcc.yaml)"
                                cmd = [
                                    "apply",
                                    "-f namespace-secret-tcc.yaml",
                                    "--kubeconfig=config.yaml",
                                    "--context ${kubeContextName}",
                                ].join(' ')
                                sh "kubectl ${cmd}"
                                echo "🧭 Deploying with Helm (กำลัง deploy ด้วย Helm)"
                                
                                cmd = [
                                    'upgrade',
                                    '--install',
                                    "--kubeconfig=config.yaml",
                                    "--kube-context ${kubeContextName}",
                                    "--namespace ${helmNamespace}",
                                    "--set image.tag=${tag}",
                                    "-f ${helmValue}",
                                    "${appName} ."
                                ].join(' ')
                                sh "helm3 ${cmd}"
                                echo "🚀 Helm deploy complete"

                                if (mode != 'production') {
                                    echo "🧹 Restarting pods for update (ลบ Pod เดิมเพื่อให้โหลดใหม่)"
                                    cmd = [
                                        'delete',
                                        'pod',
                                        "--kubeconfig=config.yaml",
                                        "--context ${kubeContextName}",
                                        "--namespace ${helmNamespace}",
                                        "--selector=app.kubernetes.io/instance=${appName}",
                                    ].join(' ')
                                    sh "kubectl ${cmd}"
                                    echo "🔍 Selector: app.kubernetes.io/instance=${appName} (ตัวกรองสำหรับลบ pods)"
                                    echo "📍 Namespace: ${helmNamespace} (ลบ pods ใน namespace นี้)"

                                     //sleep 15s (หน่วงเวลา 15 วินาที ก่อนตรวจสอบสถานะ Pod)
                                    echo "⏳ Waiting 15 seconds before checking pod status (⏳ หน่วงเวลา 15 วินาทีก่อนตรวจสอบสถานะ Pod)"
                                    sleep 15
                                    
                                }

                                //Pod status check complete (ตรวจสอบสถานะ Pod เสร็จเรียบร้อย)"
                                echo "-----------------------------------------Show more (แสดงเพิ่มเติม)-----------------------------------------"
                                echo "🔎 Checking pod status (ตรวจสอบสถานะ Pod)"
                                echo "----------------------------------------------"
                                cmd = [
                                    'get',
                                    'pods',
                                    "--kubeconfig=config.yaml",
                                    "--context ${kubeContextName}",
                                    "--namespace ${helmNamespace}",
                                    "--selector=app.kubernetes.io/instance=${appName}",
                                    "--output=wide"
                                ].join(' ')
                                sh "kubectl ${cmd}"
                                echo "✅ Pod status check complete (✅ ตรวจสอบสถานะ Pod เสร็จเรียบร้อย)"
                                echo ""
                                echo "-----------------------------------------Show more (แสดงเพิ่มเติม)-----------------------------------------"
                                echo "📋 Show logs from pods (แสดง log จาก pods)"
                                echo "----------------------------------------------"
                                // ดึงชื่อ Pod ทั้งหมดที่ตรง selector มาเก็บใน list
                                def podsList = sh(
                                    script: "kubectl get pods --kubeconfig=config.yaml --context ${kubeContextName} --namespace ${helmNamespace} --selector=app.kubernetes.io/instance=${appName} -o jsonpath='{.items[*].metadata.name}'",
                                    returnStdout: true
                                ).trim().split(' ')

                                // แสดง log ของแต่ละ pod
                                for (podName in podsList) {
                                    echo "📄 Logs from pod: ${podName}"
                                    try {
                                        sh "kubectl logs ${podName} --kubeconfig=config.yaml --context ${kubeContextName} --namespace ${helmNamespace} --tail=100"
                                    } catch (ex) {
                                    echo "⚠️ Failed to get logs from pod ${podName}: ${ex.getMessage()}"
                                    }
                                }
                                echo "--------------------------------------------------------------------------------------------------------"
                                echo ""

                                echo "✅ Deployment completed (การ deploy เสร็จสมบูรณ์)"
                                echo "🎉 Pipeline finished successfully (กระบวนการ Jenkins เสร็จสมบูรณ์)"
                            }
                        } catch (ex) {
                            echo "❌ Deployment failed (การ deploy ล้มเหลว)"
                            cleanWs()
                            error ex.getMessage()
                        }
                    }
                }
            }
        }
    }
}
